# Copy to .env on the server only. Never commit .env.
# Values come from Dev Dashboard -> your app -> Settings.

NODE_ENV=production
PORT=3010

# Store this app is installed on (must be in the same org as the app)
SHOPIFY_SHOP_DOMAIN=your-dev-store.myshopify.com

# App credentials (client credentials grant -> short-lived Admin API token)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=

SHOPIFY_API_VERSION=2026-10

# Postcode rules: regex for format check + comma-separated serviceable list
POSTCODE_REGEX=^[1-9][0-9]{5}$
SERVICEABLE_POSTCODES=400001,400050,411045,411057,560001

# Max quote requests per email per minute
RATE_LIMIT_MAX=5
